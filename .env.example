APP_NAME=AI Powered Intelligent Ticket Routing & Resolution Agent
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/tickets.db
SEED_DATA_PATH=./data/seed_tickets.json
EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FAISS_INDEX_PATH=./data/faiss.index
FAISS_METADATA_PATH=./data/faiss_metadata.json
ESCALATION_THRESHOLD=0.60
REPEAT_ISSUE_WINDOW_DAYS=30
REPEAT_ISSUE_MIN_COUNT=3
DEFAULT_TOP_K=5
